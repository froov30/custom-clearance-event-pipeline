# Copy to .env (git-ignored) and set a real password. Never commit .env.
# Use 127.0.0.1, not localhost: Windows resolves localhost to ::1 first (D-046).
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=ccp
MONGO_PASSWORD=change-me
MONGO_DB=ccp
REF_DATA_DIR=data/ref
HOLD_ALERT_SECONDS=20
MONITOR_SCAN_SECONDS=5
HEARTBEAT_DIR=.run
LOG_LEVEL=INFO
